{
  "name": "stockvision-backend",
  "version": "2.6.0",
  "description": "Sistema inteligente de gestão de estoque e logística com foco em ESG - SENAC",
  "main": "src/backend/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/backend/server.js",
    "dev": "nodemon src/backend/server.js",
    "build:css": "npx tailwindcss -i ./src/frontend/assets/css/input.css -o ./src/frontend/assets/css/tailwind.css --minify",
    "watch:css": "npx tailwindcss -i ./src/frontend/assets/css/input.css -o ./src/frontend/assets/css/tailwind.css --watch",
    "test": "node --test"
  },
  "keywords": [
    "wms",
    "logistica",
    "esg",
    "senac",
    "projeto-integrador"
  ],
  "author": "Deyson Santana",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17"
  }
}
